{
  "name": "pvomelveny-website",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run notes:chrome && npm run notes:build && astro dev",
    "build": "npm run notes:chrome && npm run notes:check && npm run notes:build && astro build",
    "preview": "astro preview",
    "notes:chrome": "node scripts/gen-wanshi-chrome.ts",
    "notes:check": "cd notes && wanshi check --strict",
    "notes:build": "cd notes && wanshi build",
    "notes:watch": "npm run notes:chrome && cd notes && wanshi serve --no-server",
    "notes:new": "cd notes && wanshi new post",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.5",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  }
}
