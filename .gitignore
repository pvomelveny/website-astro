# Astro build output
dist/
.astro/

# wanshi output — generated into public/ by `npm run notes:build`, then copied
# into dist/ by Astro. The sources live in notes/trees/.
# (wanshi's own build cache is ignored by notes/.gitignore.)
public/notes/

# wanshi serve's scratch output — `npm run notes:serve` / `notes:watch` build
# here, kept apart from public/notes/ because serve mode rewrites every link to
# be root-relative. See scripts/notes-serve.ts.
.wanshi-serve/

# Dependencies
node_modules/

# Environment & secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
