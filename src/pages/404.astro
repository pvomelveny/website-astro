---
import BaseLayout from "../components/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

/**
 * Not-found page.
 *
 * Served for every 404 on the site, including URLs under /notes/ — those pages
 * are generated by wanshi and have their own chrome, but the error page is
 * Astro's, so a reader who mistypes a note URL lands here with the ordinary
 * site nav. That is intended: it is a site-level page, not a notes page.
 *
 * Requires a CloudFront custom error response to be useful in production.
 * With OAC and a bucket policy granting only `s3:GetObject`, S3 answers a
 * missing key with 403 rather than 404 — it will not confirm whether the object
 * exists — so **both** 403 and 404 must be mapped to /404.html with an HTTP 404
 * response code. See the deployment section of the README.
 */

// ── Page content ──────────────────────────────────────────────────────────────
const heading = "Page not found";

const intro =
  "That address doesn't lead anywhere — it may have been mistyped, or the page " +
  "may have moved since the link was made.";

const destinations = [
  { href: "/", label: "Home", note: "Bio and recent notes" },
  { href: "/notes/", label: "Notes", note: "Writing on mathematics — searchable" },
  { href: "/research", label: "Research", note: "Papers, preprints, and talks" },
  { href: "/teaching", label: "Teaching", note: "Courses taught and TA'd" },
  { href: "/about", label: "About", note: "Longer introduction and CV" },
];
// ─────────────────────────────────────────────────────────────────────────────
---

<BaseLayout title={heading} description={intro} noindex>
  <Nav />

  <div class="page-header">
    <div class="error-code">error 404</div>
    <h1 class="page-title">{heading}</h1>
    <p class="page-intro">{intro}</p>
  </div>

  <div class="content">
    <h2 class="section-label">Try one of these</h2>

    <ul class="dest-list">
      {
        destinations.map(({ href, label, note }) => (
          <li class="dest-row">
            <a class="dest-link" href={href}>
              {label}
            </a>
            <span class="dest-note">{note}</span>
          </li>
        ))
      }
    </ul>

    <p class="fallback">
      If you followed a link here from elsewhere and think it should work,
      <a href={`mailto:${site.email}`}>let me know</a>.
    </p>
  </div>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: 3rem var(--pad-h) 2rem;
    max-width: var(--content-max);
  }

  .error-code {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .content {
    padding: 2.5rem var(--pad-h);
    max-width: var(--content-max);
  }

  .section-label {
    font-size: 11px;
    font-weight: inherit;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 0.5px solid var(--border);
  }

  .dest-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .dest-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 0 1.5rem;
    padding: 0.6rem 0;
    border-bottom: 0.5px solid var(--surface);
    align-items: baseline;
  }

  .dest-row:last-child {
    border-bottom: none;
  }

  .dest-link {
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
  }

  .dest-link:hover {
    color: var(--accent);
  }

  .dest-note {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
  }

  .fallback {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
    margin-top: 2.5rem;
  }

  .fallback a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 2px;
  }

  @media (max-width: 680px) {
    .dest-row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
