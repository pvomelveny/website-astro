---
import BaseLayout from '../components/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { currentCourse, currentClassNote, pastCourses } from '../data/teaching';
import type { TeachingEntry } from '../types/teaching';

const TERM_ORDER: Record<string, number> = {
  winter: 1, spring: 2, summer: 3, fall: 4, autumn: 4,
};

/** Parse "Fall 2025" → sortable integer 20254, "Winter 2026" → 20261. */
function termSortKey(term: string): number {
  const [name, year] = term.trim().toLowerCase().split(/\s+/);
  return parseInt(year ?? '0') * 10 + (TERM_ORDER[name] ?? 0);
}

function termYear(term: string): number {
  const parts = term.trim().split(/\s+/);
  return parseInt(parts[parts.length - 1] ?? '0');
}

/** "Summer 2025" → "Summer" */
function termName(term: string): string {
  return term.trim().split(/\s+/)[0] ?? term;
}

const sorted = [...pastCourses].sort(
  (a, b) => termSortKey(b.term) - termSortKey(a.term)
);

type YearGroup      = { year: number; entries: TeachingEntry[] };
type InstitutionGroup = { institution: string; years: YearGroup[] };

// Build institution → year → entries map (insertion order follows `sorted`)
const instMap = new Map<string, Map<number, TeachingEntry[]>>();
for (const entry of sorted) {
  const year = termYear(entry.term);
  if (!instMap.has(entry.institution)) instMap.set(entry.institution, new Map());
  const yearMap = instMap.get(entry.institution)!;
  if (!yearMap.has(year)) yearMap.set(year, []);
  yearMap.get(year)!.push(entry);
}

// Convert to sorted structure: years descending within each institution
const institutions: InstitutionGroup[] = [];
for (const [institution, yearMap] of instMap) {
  const years: YearGroup[] = [...yearMap.entries()]
    .map(([year, entries]) => ({ year, entries }))
    .sort((a, b) => b.year - a.year);
  institutions.push({ institution, years });
}

// Sort institutions by most recent year desc; alphabetical as tiebreaker
institutions.sort(
  (a, b) => b.years[0].year - a.years[0].year || a.institution.localeCompare(b.institution)
);
---

<BaseLayout title="Teaching" description="Courses taught and TA'd.">
  <Nav active="teaching" />

  <div class="page-header">
    <h1 class="page-title">Teaching</h1>
  </div>

  <div class="content">

    <div class="t-section">
      <div class="t-section-label">Currently Teaching</div>
      {currentCourse ? (
        <div class="current-course">
          <div class="course-title">{currentCourse.title}</div>
          <div class="course-meta">
            {currentCourse.term} · {currentCourse.role} · {currentCourse.institution}
          </div>
          <div class="class-note">
            {currentCourse.url
              ? <><a href={currentCourse.url} target="_blank" rel="noopener">Canvas</a> — {currentClassNote}</>
              : currentClassNote
            }
          </div>
        </div>
      ) : (
        <p class="empty">Not currently teaching.</p>
      )}
    </div>

    <div class="t-section">
      <div class="t-section-label">Past Courses</div>
      {institutions.length > 0 ? (
        <div class="inst-list">
          {institutions.map((inst) => (
            <div class="inst-group">
              <div class="inst-name">{inst.institution}</div>
              {inst.years.map((yg) => (
                <div class="year-group">
                  <div class="year-label">{yg.year}</div>
                  <div class="course-list">
                    {yg.entries.map((c) => (
                      <div class="course-row">
                        <div class="course-term">{termName(c.term)}</div>
                        <div class="course-title">{c.title}</div>
                        <div class="course-role">{c.role}</div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      ) : (
        <p class="empty">No past courses listed yet.</p>
      )}
    </div>

  </div>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: 3rem var(--pad-h) 2rem;
    max-width: var(--content-max);
  }

  .content {
    padding: 2.5rem var(--pad-h);
    max-width: var(--content-max);
  }

  .t-section { margin-bottom: 2.5rem; }

  .t-section-label {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 0.5px solid var(--border);
  }

  /* Current course */
  .current-course {
    padding: 0.75rem 1rem;
    background: var(--surface);
    border-left: 2px solid var(--border);
  }

  .current-course .course-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .current-course .course-meta {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .class-note {
    font-size: 13px;
    color: var(--muted);
  }

  .class-note a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 2px;
  }

  /* Past courses — institution → year → entries */
  .inst-list { display: flex; flex-direction: column; gap: 3rem; }

  .inst-name {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 0.5px solid var(--border);
  }

  .year-group { margin-bottom: 1.1rem; }
  .year-group:last-child { margin-bottom: 0; }

  .year-label {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--ink);
    margin-bottom: 0.25rem;
    padding-left: 1rem;
  }

  .course-list { display: flex; flex-direction: column; }

  .course-row {
    display: grid;
    grid-template-columns: 80px 1fr 80px;
    gap: 0 1.25rem;
    padding: 0.35rem 0;
    padding-left: 2rem;
    border-bottom: 0.5px solid var(--surface);
    align-items: baseline;
  }

  .course-row:last-child { border-bottom: none; }

  .course-term {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .course-title {
    font-size: 14px;
    color: var(--ink);
  }

  .course-role {
    font-size: 12px;
    color: var(--muted);
    text-align: right;
    letter-spacing: 0.02em;
  }

  .empty { font-size: 14px; color: var(--muted); }
</style>
