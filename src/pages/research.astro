---
import BaseLayout from "../components/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Paper from "../components/Paper.astro";
import Talk from "../components/Talk.astro";
import Writing from "../components/Writing.astro";
import researchData from "../data/research";

// ── Page content ──────────────────────────────────────────────────────────────
const intro = `My work sits at the intersection of combinatorial optimization and
  discrete mathematics. I am particularly drawn to questions about polyhedral
  structure and what it reveals about the complexity of optimization problems.`;
// ─────────────────────────────────────────────────────────────────────────────

const { papers, preprints, additionalWriting } = researchData;
const talks = [...researchData.talks].sort(
  (a, b) => b.year * 12 + b.month - (a.year * 12 + a.month),
);
---

<BaseLayout
  title="Research"
  description="Research papers, preprints, and talks."
>
  <Nav active="research" />

  <div class="page-header">
    <h1 class="page-title">Research</h1>
    <!--<p class="page-intro">{intro}</p>-->
  </div>

  <div class="content">
    {
      papers.length > 0 && (
        <div class="r-section">
          <div class="r-section-label">papers</div>
          {papers.map((paper, i) => (
            <>
              {i > 0 && <div class="divider-light" />}
              <Paper paper={paper} />
            </>
          ))}
        </div>
      )
    }

    {
      preprints.length > 0 && (
        <div class="r-section">
          <div class="r-section-label">preprints</div>
          {preprints.map((paper, i) => (
            <>
              {i > 0 && <div class="divider-light" />}
              <Paper paper={paper} />
            </>
          ))}
        </div>
      )
    }

    {
      talks.length > 0 && (
        <div class="r-section">
          <div class="r-section-label">talks</div>
          {talks.map((talk, i) => (
            <>
              {i > 0 && <div class="divider-light" />}
              <Talk talk={talk} />
            </>
          ))}
        </div>
      )
    }

    {
      additionalWriting.length > 0 && (
        <div class="r-section">
          <div class="r-section-label">additional writing</div>
          {additionalWriting.map((item, i) => (
            <>
              {i > 0 && <div class="divider-light" />}
              <Writing item={item} />
            </>
          ))}
        </div>
      )
    }

    {
      papers.length === 0 &&
        preprints.length === 0 &&
        talks.length === 0 &&
        additionalWriting.length === 0 && (
          <p class="empty">Publications coming soon.</p>
        )
    }
  </div>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: 3rem var(--pad-h) 2rem;
    max-width: var(--content-max);
  }

  .page-intro {
    max-width: 560px;
  }

  .content {
    padding: 2.5rem var(--pad-h);
    max-width: var(--content-max);
  }

  .r-section {
    margin-bottom: 2.5rem;
  }

  .r-section-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .divider-light {
    height: 0.5px;
    background: var(--surface);
    margin: 1rem 0;
  }

  .empty {
    font-size: 15px;
    color: var(--muted);
  }
</style>

<script>
  import { initAbstractToggles } from "../scripts/abstracts";
  initAbstractToggles();
</script>
