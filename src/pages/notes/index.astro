---
import BaseLayout from "../../components/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import { noteHref } from "../../types/note";

const allNotes = await getCollection("notes");

const pageIntro =
  "Informal writing about mathematics I am thinking about — some polished, some not. " +
  "A mix of exposition, reading notes, and problems that interest me.";

// Sort descending by date, then group by year
const sorted = allNotes.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/** Group an array of notes by calendar year, preserving sort order. */
function groupByYear(notes: typeof sorted): Map<number, typeof sorted> {
  const map = new Map<number, typeof sorted>();
  for (const note of notes) {
    const year = note.data.date.getFullYear();
    if (!map.has(year)) map.set(year, []);
    map.get(year)!.push(note);
  }
  return map;
}

const byYear = groupByYear(sorted);

function formatMonth(date: Date): string {
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---

<BaseLayout title="Notes" description="Informal writing about mathematics.">
  <Nav active="notes" />

  <div class="notes-header">
    <div class="title-row">
      <h1 class="page-title">Notes</h1>
      <a href="/rss.xml" class="rss-link" title="Subscribe via RSS">
        <svg class="rss-icon" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="3" cy="13" r="1.5"></circle>
          <path
            d="M2 8.5a.5.5 0 0 1 .5-.5 7 7 0 0 1 7 7 .5.5 0 0 1-1 0 6 6 0 0 0-6-6 .5.5 0 0 1-.5-.5z"
          ></path>
          <path
            d="M2 4a.5.5 0 0 1 .5-.5 11 11 0 0 1 11 11 .5.5 0 0 1-1 0A10 10 0 0 0 2.5 4.5.5.5 0 0 1 2 4z"
          ></path>
        </svg>
        RSS
      </a>
    </div>
    <p class="page-intro">{pageIntro}</p>
  </div>

  <div class="notes-content">
    {
      [...byYear.entries()].map(([year, notes]) => (
        <div class="year-group">
          <h2 class="year-label">{year}</h2>
          {notes.map((note) => (
            <div class="note-entry">
              <div class="entry-date">{formatMonth(note.data.date)}</div>
              <div>
                <div class="entry-title-row">
                  <h3 class="entry-title">
                    <a href={noteHref(note.id)}>{note.data.title}</a>
                  </h3>
                  <span class="entry-tag">{note.data.tag}</span>
                </div>
                <div class="entry-desc">{note.data.description}</div>
              </div>
            </div>
          ))}
        </div>
      ))
    }

    {allNotes.length === 0 && <p class="empty">No notes yet.</p>}
  </div>

  <Footer />
</BaseLayout>

<style>
  .title-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface);
    border: 0.5px solid var(--border);
    padding: 2px 9px 2px 7px;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .rss-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .rss-icon {
    width: 11px;
    height: 11px;
    fill: currentColor;
    flex-shrink: 0;
    /* nudge down slightly to optically align with baseline */
    position: relative;
    top: 1px;
  }

  .notes-header {
    padding: 3rem var(--pad-h) 2rem;
    max-width: var(--notes-max);
    border-bottom: 1px solid var(--muted);
  }

  .notes-content {
    padding: 2.5rem var(--pad-h);
    max-width: var(--notes-max);
  }

  .year-group {
    margin-bottom: 2.5rem;
  }

  .year-label {
    font-size: 11px;
    font-weight: inherit;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 0.5px solid var(--surface);
  }

  .note-entry {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 0.5px solid var(--surface);
    align-items: baseline;
  }

  .note-entry:last-child {
    border-bottom: none;
  }

  .entry-date {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.03em;
    white-space: nowrap;
    padding-top: 2px;
  }

  .entry-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 400;
    font-style: italic;
    line-height: inherit;
  }

  .entry-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .entry-title a:hover {
    color: var(--accent);
  }

  .entry-tag {
    font-size: 11px;
    color: var(--muted);
    background: var(--surface);
    border: 0.5px solid var(--border);
    padding: 1px 7px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .entry-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
  }

  .empty {
    font-size: 15px;
    color: var(--muted);
  }
</style>
