---
import BaseLayout from "../../components/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const allNotes = await getCollection("notes");

const pageIntro: string[] = [
  "Informal writing about mathematics I am thinking about — some polished, some not.",
  "A mix of exposition, reading notes, and problems that interest me.",
];

// Sort descending by date, then group by year
const sorted = allNotes.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/** Group an array of notes by calendar year, preserving sort order. */
function groupByYear(notes: typeof sorted): Map<number, typeof sorted> {
  const map = new Map<number, typeof sorted>();
  for (const note of notes) {
    const year = note.data.date.getFullYear();
    if (!map.has(year)) map.set(year, []);
    map.get(year)!.push(note);
  }
  return map;
}

const byYear = groupByYear(sorted);

function formatMonth(date: Date): string {
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---

<BaseLayout title="Notes" description="Informal writing about mathematics.">
  <Nav active="notes" />

  <div class="notes-header">
    <h1 class="page-title">Notes</h1>
    <p class="page-intro">
      {pageIntro.join(" ")}
    </p>
  </div>

  <div class="notes-content">
    {
      [...byYear.entries()].map(([year, notes]) => (
        <div class="year-group">
          <div class="year-label">{year}</div>
          {notes.map((note) => (
            <div class="note-entry">
              <div class="entry-date">{formatMonth(note.data.date)}</div>
              <div>
                <div class="entry-title-row">
                  <a
                    href={`/notes/${note.id.replace(/\.mdx?$/, "")}`}
                    class="entry-title"
                  >
                    {note.data.title}
                  </a>
                  <span class="entry-tag">{note.data.tag}</span>
                </div>
                <div class="entry-desc">{note.data.description}</div>
              </div>
            </div>
          ))}
        </div>
      ))
    }

    {allNotes.length === 0 && <p class="empty">No notes yet.</p>}
  </div>

  <Footer />
</BaseLayout>

<style>
  .notes-header {
    padding: 3rem var(--pad-h) 2rem;
    max-width: var(--notes-max);
    border-bottom: 0.5px solid var(--border);
  }

  .notes-content {
    padding: 2.5rem var(--pad-h);
    max-width: var(--notes-max);
  }

  .year-group {
    margin-bottom: 2.5rem;
  }

  .year-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 0.5px solid var(--surface);
  }

  .note-entry {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 0.5px solid var(--surface);
    align-items: baseline;
  }

  .note-entry:last-child {
    border-bottom: none;
  }

  .entry-date {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.03em;
    white-space: nowrap;
    padding-top: 2px;
  }

  .entry-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 400;
    color: var(--ink);
    text-decoration: none;
    font-style: italic;
  }

  .entry-title:hover {
    color: var(--accent);
  }

  .entry-tag {
    font-size: 11px;
    color: var(--muted);
    background: var(--surface);
    border: 0.5px solid var(--border);
    padding: 1px 7px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .entry-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
  }

  .empty {
    font-size: 15px;
    color: var(--muted);
  }
</style>
