---
import Coauthors from './Coauthors.astro';
import type { Writing } from '../types/research';

interface Props {
  item: Writing;
}

const { item } = Astro.props;
const { title, subtitle, year, coauthors, links, abstract } = item;
---

<div class="writing">
  <h3 class="writing-title">{title}</h3>
  <div class="writing-subtitle">{subtitle}, {year}</div>
  {coauthors && <Coauthors items={coauthors} />}
  <div class="writing-links">
    {links.pdf && <a href={links.pdf} target="_blank" rel="noopener noreferrer">pdf</a>}
    {links.link && <a href={links.link} target="_blank" rel="noopener noreferrer">link</a>}
    {abstract && (
      <button class="abstract-toggle" type="button">+ abstract</button>
    )}
  </div>
  {abstract && <div class="abstract">{abstract}</div>}
</div>

<style>
  .writing { margin-bottom: 0; }

  .writing-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    line-height: var(--leading-tight);
    margin-bottom: 0.2rem;
  }

  .writing-subtitle {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  .writing-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 0.35rem;
  }

  .writing-links a {
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 2px;
    margin-right: 1rem;
  }
</style>
