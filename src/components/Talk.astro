---
import type { Talk } from '../types/research';

interface Props {
  talk: Talk;
}

const { talk } = Astro.props;
const { title, venue, year, month, links } = talk;

const date = new Date(year, month - 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<div class="talk">
  <div class="talk-row">
    <div class="talk-title">{title}</div>
    <div class="talk-date">{date}</div>
  </div>
  {venue && <div class="talk-venue">{venue}</div>}
  {links?.slides && (
    <div class="talk-links">
      <a href={links.slides} target="_blank" rel="noopener">slides</a>
    </div>
  )}
</div>

<style>
  .talk { margin-bottom: 0; }

  .talk-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
  }

  .talk-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 0.15rem;
  }

  .talk-date {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .talk-venue {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }

  .talk-links a {
    font-size: 12px;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 2px;
  }
</style>
