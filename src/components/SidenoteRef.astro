---
/**
 * Inline sidenote reference marker. Renders as a superscript number in
 * accent color. Place this inside body text at the citation point.
 *
 * The `n` prop must match the corresponding <Sidenote n={…}>.
 */
interface Props {
  n: number;
}

const { n } = Astro.props;
---

<span class="sn-ref" data-sn={n}>{n}</span>

<style>
  .sn-ref {
    font-size: 10px;
    color: var(--accent);
    vertical-align: super;
    line-height: 0;
    margin-left: 1px;
    font-family: var(--font-body);
  }
</style>
