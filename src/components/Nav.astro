---
import { site } from '../data/site';

/** Current page key, used to mark the active nav link. */
interface Props {
  active?: 'about' | 'research' | 'teaching' | 'notes' | 'cv';
}

const { active } = Astro.props;

const links = [
  { href: '/about',       label: 'about',    key: 'about'    },
  { href: '/research',    label: 'research', key: 'research' },
  { href: '/teaching',    label: 'teaching', key: 'teaching' },
  { href: '/notes',       label: 'notes',    key: 'notes'    },
  { href: site.cvUrl,     label: 'cv',       key: 'cv'       },
] as const;
---

<nav>
  <a href="/" class="nav-name">
    {site.firstName} <span>{site.lastName}</span>
  </a>
  <div class="nav-links">
    {links.map(({ href, label, key }) => (
      <a href={href} class={active === key ? 'active' : undefined}>{label}</a>
    ))}
  </div>
</nav>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.75rem var(--pad-h);
    border-bottom: 2px solid var(--accent);
  }

  .nav-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .nav-name span {
    color: var(--accent);
    font-style: italic;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .nav-links a.active,
  .nav-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 680px) {
    nav { padding: 1.25rem var(--pad-h); }
  }
</style>
