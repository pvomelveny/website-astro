---
import Coauthors from './Coauthors.astro';
import type { Paper, Preprint } from '../types/research';

interface Props {
  paper: Paper | Preprint;
}

const { paper } = Astro.props;
const { title, coauthors, year, tags, links, abstract } = paper;
const venue  = 'venue'  in paper ? paper.venue  : undefined;
const volume = 'volume' in paper ? paper.volume : undefined;
const pages  = 'pages'  in paper ? paper.pages  : undefined;

/**
 * Roman-typeface suffix after the italic journal name: ", vol. X, pp. Y, YEAR".
 * Built as a single string so JSX whitespace doesn't insert a gap before each comma.
 */
function venueSuffix(): string {
  const parts: string[] = [];
  if (volume) parts.push(`vol. ${volume}`);
  if (pages) parts.push(`pp. ${pages}`);
  parts.push(String(year));
  return `, ${parts.join(', ')}`;
}
---

<div class="paper">
  <div class="paper-row">
    <div class="paper-main">
      <h3 class="paper-title">{title}</h3>
      {coauthors && <Coauthors items={coauthors} />}
      <div class="paper-venue">
        {venue
          ? <><span class="journal">{venue}</span>{venueSuffix()}</>
          : year}
      </div>
      {tags.length > 0 && (
        <div class="paper-tags">
          {tags.map((t) => <span class="ptag">{t}</span>)}
        </div>
      )}
      <div class="paper-links">
        {links.journal && <a href={links.journal} target="_blank" rel="noopener noreferrer">journal</a>}
        {links.pdf && <a href={links.pdf} target="_blank" rel="noopener noreferrer">pdf</a>}
        {links.arxiv && <a href={links.arxiv} target="_blank" rel="noopener noreferrer">arXiv</a>}
        {'link' in links && links.link && <a href={links.link} target="_blank" rel="noopener noreferrer">link</a>}
        {abstract && (
          <button class="abstract-toggle" type="button">+ abstract</button>
        )}
      </div>
      {abstract && <div class="abstract">{abstract}</div>}
    </div>
    <div class="paper-year">{year}</div>
  </div>
</div>

<style>
  .paper { margin-bottom: 0; }

  .paper-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .paper-main { flex: 1; }

  .paper-year {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
    white-space: nowrap;
    padding-top: 3px;
  }

  .paper-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    line-height: 1.4;
    margin-bottom: 0.35rem;
  }

  .paper-venue {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .journal { font-style: italic; }

  .paper-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.6rem;
  }

  .ptag {
    font-size: 11px;
    color: var(--muted);
    background: var(--surface);
    border: 0.5px solid var(--border);
    padding: 1px 7px;
    letter-spacing: 0.02em;
  }

  .paper-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .paper-links a {
    font-size: 12px;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 2px;
    margin-right: 1rem;
  }
</style>
