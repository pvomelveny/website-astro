---
import type { Paper, Preprint } from '../types/research';
import { site } from '../data/site';

interface Props {
  paper: Paper | Preprint;
}

const { paper } = Astro.props;
const { title, authors, year, tags, links, abstract } = paper;
const venue  = 'venue'  in paper ? paper.venue  : undefined;
const volume = 'volume' in paper ? paper.volume : undefined;
const pages  = 'pages'  in paper ? paper.pages  : undefined;

/** Format the venue line: journal name (italic), optional vol/pages. */
function venueString(): string {
  let v = venue ?? '';
  if (volume) v += `, vol. ${volume}`;
  if (pages) v += `, pp. ${pages}`;
  return v;
}

/**
 * Collapse a full name to bare concatenated initials.
 * "Patrick Von O'Melveny" → "PVO"
 * The owner's entry in site.fullName must include all name parts
 * (including middle name/initial) for this to produce the right result.
 */
function toInitials(fullName: string): string {
  return fullName
    .trim()
    .split(/\s+/)
    .map((p) => p[0].toUpperCase())
    .join('');
}
---

<div class="paper">
  <div class="paper-row">
    <div class="paper-main">
      <div class="paper-title">{title}</div>
      <div class="paper-authors">
        {authors.map((a, i) => {
          const isOwner = a === site.fullName;
          // Owner: show initials in ink color. Co-authors: full name, muted.
          const display = isOwner ? toInitials(a) : a;
          return (
            <>
              {i > 0 && ', '}
              {isOwner ? <em>{display}</em> : display}
            </>
          );
        })}
      </div>
      <div class="paper-venue">
        {venue
          ? <><span class="journal" set:html={venueString()} />, {year}</>
          : year
        }
      </div>
      {tags.length > 0 && (
        <div class="paper-tags">
          {tags.map((t) => <span class="ptag">{t}</span>)}
        </div>
      )}
      <div class="paper-links">
        {links.journal && <a href={links.journal} target="_blank" rel="noopener">journal</a>}
        {links.pdf && <a href={links.pdf} target="_blank" rel="noopener">pdf</a>}
        {links.arxiv && <a href={links.arxiv} target="_blank" rel="noopener">arXiv</a>}
        {abstract && (
          <button class="abstract-toggle" type="button">+ abstract</button>
        )}
      </div>
      {abstract && <div class="abstract">{abstract}</div>}
    </div>
    <div class="paper-year">{year}</div>
  </div>
</div>

<style>
  .paper { margin-bottom: 1.75rem; }

  .paper-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .paper-main { flex: 1; }

  .paper-year {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
    white-space: nowrap;
    padding-top: 3px;
  }

  .paper-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    line-height: 1.4;
    margin-bottom: 0.35rem;
  }

  .paper-authors {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }

  /* Site owner's name (initials form) rendered in ink to stand out from co-authors. */
  .paper-authors em {
    color: var(--ink);
    font-style: normal;
  }

  .paper-venue {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .journal { font-style: italic; }

  .paper-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.6rem;
  }

  .ptag {
    font-size: 11px;
    color: var(--muted);
    background: var(--surface);
    border: 0.5px solid var(--border);
    padding: 1px 7px;
    letter-spacing: 0.02em;
  }

  .paper-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .paper-links a {
    font-size: 12px;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 2px;
    margin-right: 1rem;
  }

  .abstract-toggle {
    font-size: 10px;
    color: var(--ink);
    cursor: pointer;
    background: var(--surface);
    border: 0.5px solid var(--border);
    padding: 1px 6px;
    font-family: var(--font-body);
    letter-spacing: 0.03em;
    margin-left: 0.25rem;
  }

  .abstract-toggle:hover { border-color: var(--muted); }

  .abstract {
    font-size: 14px;
    line-height: 1.75;
    color: var(--muted);
    margin-top: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border-left: 2px solid var(--border);
    display: none;
  }

  .abstract.open { display: block; }
</style>
